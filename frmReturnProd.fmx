  object qAdd: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'EXECUTE PROCEDURE SET_RET_TOV_2(:NG,'
      '                                :ID_TRAN,'
      '                                :BAR_CODE)'
      '')
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end
      item
        Name = 'ID_TRAN'
        ParamType = ptInput
      end
      item
        Name = 'BAR_CODE'
        ParamType = ptInput
      end>
    Left = 416
    Top = 416
  end
  object qList: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select LR.CENA_MOD,'
      '       MT.NAZVAN,'
      '       count(LR.NO_MODSIZ) COUNT_OF_NO_MODSIZ,'
      '       LR.DATA_RET,'
      '       LR.ID_TRANSACTION,'
      '       LR.NO_AGN,'
      '       MT.NO_MOD'
      'from MODEL_TABLE MT'
      'inner join MODEL_SIZE_TABLE MS on (MT.NO_MOD = MS.NO_MOD)'
      'inner join LOG_RET_PROD LR on (MS.NO_MST = LR.NO_MODSIZ)'
      'where ((LR.IS_OK = false) and'
      '      (LR.NO_AGN = :NG))'
      
        'group by LR.CENA_MOD, MT.NAZVAN, LR.DATA_RET, LR.ID_TRANSACTION,' +
        ' LR.NO_AGN, MT.NO_MOD'
      'order by MT.NAZVAN  '
      '')
    Left = 496
    Top = 416
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
  end
  object qHist: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT LP.DATA_PROD,'
      '       MT.NAZVAN M_NAZVAN,'
      '       MT.NO_MOD,'
      '       COUNT(LP.NO_LPT) CNT_MOD_PROD,'
      '       LP.CENA_PROD,'
      '       VT.NAZVAN V_NAZVAN'
      'FROM LOG_PROD_TABLE LP'
      'INNER JOIN MODEL_SIZE_TABLE MST ON (LP.NO_MOD_SIZE = MST.NO_MST)'
      'INNER JOIN MODEL_TABLE MT ON (MST.NO_MOD = MT.NO_MOD)'
      'INNER JOIN VALUT_TABLE VT ON (LP.NO_VAL = VT.NO_VAL)'
      'WHERE ((LP.NO_AGN = :NG) AND'
      '      (MT.NO_MOD = :NM))'
      
        'GROUP BY LP.DATA_PROD, MT.NAZVAN, MT.NO_MOD, LP.CENA_PROD, VT.NA' +
        'ZVAN'
      'ORDER BY LP.DATA_PROD DESC  ')
    Left = 456
    Top = 416
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end
      item
        Name = 'NM'
        ParamType = ptInput
      end>
  end
  object qUpd_Cena: TFDCommand
    Connection = fmMain.IBC
