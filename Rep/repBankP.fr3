    <TfrxFDQuery Name="qBank" UserName="Банки" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT (sum(LSB.SUM_OF_VSUM_OPL)+sum(LSB.SUM_IN_VALUT)) as SUM_OF_VSUM_OPL,&#13;&#10;       LSB.MY_BANK,&#13;&#10;       LSB.NAZVAN,&#13;&#10;       LSB.MY_USER,&#13;&#10;       sum(LSB.SUM_OF_SUM_OPL) as SUM_OF_SUM_OPL,&#13;&#10;       avg(LSB.AVG_OF_KURS_VAL) as AVG_OF_KURS_VAL&#13;&#10;FROM GET_LOG_BANK_FULL_SUM(:SD, :ED) LSB&#13;&#10;group by LSB.MY_BANK, LSB.NAZVAN, LSB.MY_USER" PropData="05704C65667402340470546F7002500A506172616D657465727301010634204E616D653D225344222044617461547970653D22667444617465222045787072657373696F6E3D22734461746153746172742200010632204E616D653D224544222044617461547970653D22667444617465222045787072657373696F6E3D227344617461456E64220000"/>
