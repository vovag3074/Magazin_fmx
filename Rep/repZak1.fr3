    <TfrxFDQuery Name="qAgn" UserName="Agent" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="select&#13;&#10;    SZ.PRIM_ZAK,&#13;&#10;    SZ.IS_OK,&#13;&#10;    SZD.CNT_MOD,&#13;&#10;    MTT.NAZVAN,&#13;&#10;    SMT.NO_SIZE,&#13;&#10;    AG.AG_NAME,&#13;&#10;    STT.ST_NAME,&#13;&#10;    TMD.NAME_TYPE&#13;&#10;from SET_ZAKAZ_DETAIL SZD&#13;&#10;inner join SET_ZAKAZ SZ on (SZD.NO_SET_ZAK = SZ.NO_SZ)&#13;&#10;inner join AGENTS AG on (SZ.NO_AGN = AG.NO_AGN)&#13;&#10;inner join SITY_TABLE STT on (AG.NO_SITY = STT.NO_ST)&#13;&#10;inner join MODEL_SIZE_TABLE MST on (SZD.NO_MSIS = MST.NO_MST)&#13;&#10;inner join MODEL_TABLE MTT on (MST.NO_MOD = MTT.NO_MOD)&#13;&#10;inner join KATEGORY_TABLE KTG on (MTT.NO_KAT = KTG.NO_KAT)&#13;&#10;inner join TYPE_MOD TMD on (KTG.NO_TYPE = TMD.NO_TM)&#13;&#10;inner join SIZE_MOD_TABLE SMT on (MST.NO_SIZE = SMT.NO_SMT)&#13;&#10;where ((SZ.DATA_OTP = :ED))&#13;&#10;order by TMD.NAME_TYPE, AG.AG_NAME, STT.ST_NAME, MTT.NAZVAN, SMT.NO_SIZE" PropData="05704C65667402500470546F7002500A506172616D657465727301010636204E616D653D224544222044617461547970653D22667444617465222045787072657373696F6E3D22262336303B4454262336323B220000"/>
