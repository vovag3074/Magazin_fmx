    <TfrxFDQuery Name="IB_Query1" UserName="IB_Query1" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="select&#13;&#10;    agents.ag_name,&#13;&#10;    sity_table.st_name,&#13;&#10;    model_table.nazvan,&#13;&#10;    set_zakaz_detail.cnt_mod,&#13;&#10;    size_mod_table.no_size&#13;&#10;     , set_zakaz.DATA_OTP&#13;&#10;     , set_zakaz.PRIM_ZAK&#13;&#10;from model_size_table&#13;&#10;   inner join set_zakaz_detail on (model_size_table.no_mst = set_zakaz_detail.no_msis)&#13;&#10;   inner join set_zakaz on (set_zakaz_detail.no_set_zak = set_zakaz.no_sz)&#13;&#10;   inner join agents on (set_zakaz.no_agn = agents.no_agn)&#13;&#10;   inner join sity_table on (agents.no_sity = sity_table.no_st)&#13;&#10;   inner join model_table on (model_size_table.no_mod = model_table.no_mod)&#13;&#10;   inner join size_mod_table on (model_size_table.no_size = size_mod_table.no_smt)&#13;&#10;where&#13;&#10;   (&#13;&#10;      (set_zakaz.data_otp &#62;= :SD)&#13;&#10;   and&#13;&#10;      (model_table.no_mod = :nm)&#13;&#10;   )&#13;&#10;ORDER BY set_zakaz.DATA_OTP DESC" PropData=""/>
