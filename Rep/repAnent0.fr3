  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000">
    <TfrxFDQuery Name="qAgn" UserName="Agent" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="select AG.AG_NAME,&#13;&#10;       ST.ST_NAME,&#13;&#10;       V.NAZVAN,&#13;&#10;       AG.NO_AGN,&#13;&#10;       AG.AG_DOLG&#13;&#10;from AGENTS AG&#13;&#10;inner join SITY_TABLE ST on (AG.NO_SITY = ST.NO_ST)&#13;&#10;inner join VALUT_TABLE V on (AG.PRED_VAL = V.NO_VAL)&#13;&#10;where ((AG.AG_DOLG &#62; 0)and(AG.IS_DEL=0))&#13;&#10;order by AG.AG_DOLG desc, AG.AG_NAME" PropData="05704C65667403A0000470546F7002740A506172616D65746572730100"/>
    <TfrxFDQuery Name="qSum" UserName="Summa" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="select sum(AG.AG_DOLG) SUM_OF_AG_DOLG,&#13;&#10;       VL.NAZVAN&#13;&#10;from VALUT_TABLE VL&#13;&#10;inner join AGENTS AG on (VL.NO_VAL = AG.PRED_VAL)&#13;&#10;where AG.IS_DEL = 0&#13;&#10;group by VL.NAZVAN&#13;&#10;order by VL.NAZVAN" PropData="05704C65667403D8000470546F7002740A506172616D65746572730100"/>
  </TfrxDataPage>
