    <TfrxFDQuery Name="qOpl" UserName="Oplaty" CloseDataSource="True" FieldAliases.Text="" BCDToCurrency="False" IgnoreDupParams="False" SQL.Text="SELECT SUM(LP.SUM_OP) SUM_OF_SUM_OP,&#13;&#10;       AG.AG_DOLG,&#13;&#10;       V.NAZVAN,&#13;&#10;       AG.FULL_NAME_STD,&#13;&#10;       LP.VSUM_OP,&#13;&#10;       LP.KURS_VAL&#13;&#10;FROM AGENTS AG&#13;&#10;INNER JOIN LOG_OPLATA LP ON (AG.NO_AGN = LP.NO_AGN)&#13;&#10;INNER JOIN VALUT_TABLE V ON (LP.NO_VAL = V.NO_VAL)&#13;&#10;WHERE ((LP.DATA_OP = :ED) AND&#13;&#10;      (LP.IS_VIRT = 0) AND&#13;&#10;      (LP.IS_PRED = 0))&#13;&#10;GROUP BY AG.AG_DOLG, V.NAZVAN, AG.FULL_NAME_STD, LP.VSUM_OP, LP.KURS_VAL" PropData="05704C6566740380000470546F7002480A506172616D657465727301010636204E616D653D224544222044617461547970653D22667444617465222045787072657373696F6E3D22262336303B4454262336323B220000"/>
