  object qIns: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      
        'insert into AGENTS (NO_SITY, PRED_VAL, AG_NAME, AG_DOP, IS_DEL, ' +
        'IS_SKIDKA, IS_DEF_PROD, AG_DOLG, AG_PRED, STATUS, SUM_SKIDKA)'
      
        'values (:NO_SITY, :PRED_VAL, :AG_NAME, :AG_DOP, 0, :IS_SKIDKA, :' +
        'IS_DEF_PROD, :AG_DOLG, :AG_PRED, :STATUS, :SUM_SKIDKA)'
      '')
    ParamData = <
      item
        Name = 'NO_SITY'
        ParamType = ptInput
      end
      item
        Name = 'PRED_VAL'
        ParamType = ptInput
      end
      item
        Name = 'AG_NAME'
        ParamType = ptInput
