  object qRead: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT AG.PRED_VAL,'
      '       AG.AG_NAME,'
      '       AG.AG_DOP,'
      '       AG.IS_SKIDKA,'
      '       AG.SUM_SKIDKA'
      'FROM AGENTS AG'
      'WHERE AG.NO_AGN = :NG   '
