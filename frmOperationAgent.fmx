  end
  object qUpd: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update AGENTS'
      'set PRED_VAL = :PRED_VAL,'
      '    AG_NAME = :AG_NAME,'
      '    AG_DOP = :AG_DOP,'
      '    IS_SKIDKA = :IS_SKIDKA,'
      '    SUM_SKIDKA = :SUM_SKIDKA'
      'where (NO_AGN = :NG)'
      '')
    ParamData = <
      item
        Name = 'PRED_VAL'
        ParamType = ptInput
