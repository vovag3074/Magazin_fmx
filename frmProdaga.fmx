  object qMod2: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select M.NAZVAN M_NAZVAN,'
      '       sum(LP.CENA_PROD) SUM_PROD,'
      '       sum(LP.OPLATA) OPLATA,'
      '       LP.CENA_PROD,'
      '       K.NAZVAN K_NAZVAN,'
      '       count(LP.NO_LPT) COUNT_OF_NO_LPT,'
      '       MS.NO_MOD'
      'from MODEL_SIZE_TABLE MS'
      'inner join LOG_PROD_TABLE LP on (MS.NO_MST = LP.NO_MOD_SIZE)'
      'inner join MODEL_TABLE M on (MS.NO_MOD = M.NO_MOD)'
      'inner join KATEGORY_TABLE K on (M.NO_KAT = K.NO_KAT)'
      'where ((LP.NO_AGN = :NG) and'
      '      (LP.DATA_PROD = :SD) and'
      '      (LP.IS_TEMP = 0) and'
      '      (MS.NO_MOD = :NM))'
      'group by M.NAZVAN, LP.CENA_PROD, K.NAZVAN, MS.NO_MOD'
      'order by K.NAZVAN, M.NAZVAN  '
      '')
    Left = 750
    Top = 416
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'NM'
        ParamType = ptInput
      end>
  end
  object qSize: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select S.NO_SIZE,'
      '       count(LP.NO_LPT) COUNT_OF_NO_LPT,'
      '       LP.CENA_PROD,'
      '       sum(LP.OPLATA) OPLATA,'
      '       sum(LP.CENA_PROD) SUM_PROD,'
      '       LP.NO_MOD_SIZE'
      'from LOG_PROD_TABLE LP'
      'inner join MODEL_SIZE_TABLE M on (LP.NO_MOD_SIZE = M.NO_MST)'
      'inner join SIZE_MOD_TABLE S on (M.NO_SIZE = S.NO_SMT)'
      'where ((M.NO_MOD = :MZ) and'
      '      (LP.NO_AGN = :NG) and'
      '      (LP.DATA_PROD = :SD) and'
      '      (LP.IS_TEMP = 0))'
      'group by S.NO_SIZE, LP.CENA_PROD, LP.NO_MOD_SIZE'
      'order by S.NO_SIZE  '
      '')
    Left = 798
    Top = 416
    ParamData = <
      item
        Name = 'MZ'
        ParamType = ptInput
      end
      item
        Name = 'NG'
        ParamType = ptInput
      end
      item
        Name = 'SD'
        ParamType = ptInput
      end>
  end
