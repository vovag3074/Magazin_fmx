    <ROW Dialog_="OutOfRbDiskDlg" Control="Description" Type="Text" X="16" Y="94" Width="458" Height="57" Attributes="196611" Text="Выделенные диски не имеют достаточного свободного места для текущих выбранных функций. Вы можете либо удалить некоторые файлы с выделенных дисков, либо выбрать другой целевой диск (или диски). Кроме того, вы можете отключить функцию отката установщика. Нажмите Да, если хотите рискнуть и отключить откат." TextStyle="[DescriptionFont]" Order="400" TextLocId="AppInstaller.Control.Text.OutOfRbDiskDlg#Description" MsiKey="OutOfRbDiskDlg#Description"/>
