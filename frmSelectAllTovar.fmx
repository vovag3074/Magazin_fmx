  object qKat: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select K.NO_KAT,'
      '       K.NAZVAN,'
      '       count(M.NO_MOD) COUNT_OF_NO_MOD'
      'from MODEL_TABLE M'
      'inner join KATEGORY_TABLE K on (M.NO_KAT = K.NO_KAT)'
      'where ((M.IS_DEL = 0))'
      'group by K.NO_KAT, K.NAZVAN'
      'order by K.NAZVAN  '
      '')
    Left = 56
    Top = 360
  end
  object qMod: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select MS.CNT_MOD, M.M_CENA, M.NAZVAN, M.NO_MOD'
      'from MODEL_IN_SCLAD MS'
      'inner join MODEL_TABLE M on (MS.NO_MOD = M.NO_MOD)'
      'where ((M.NO_KAT = :NK) and'
      '      (MS.IS_VIT = 0) and'
      '      ((M.IS_DEL =0) or (MS.CNT_MOD > 0)))'
      'order by M.NAZVAN  '
      '')
    Left = 112
    Top = 360
    ParamData = <
      item
        Name = 'NK'
        ParamType = ptInput
      end>
  end
  object qSize: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct'
      '    MST.UN_CODE,'
      '    MST.NO_MST,'
      '    SMT.NO_SIZE,'
      '    E.NO_ETS'
      'from ENABLE_TYPE_SIZE E'
      'inner join SIZE_MOD_TABLE SMT on (E.NO_SIZE = SMT.NO_SMT)'
      'inner join MODEL_SIZE_TABLE MST on (SMT.NO_SMT = MST.NO_SIZE)'
      'inner join MODEL_TABLE M on (MST.NO_MOD = M.NO_MOD)'
      'inner join KATEGORY_TABLE K on (M.NO_KAT = K.NO_KAT)'
      'inner join ENABLE_TYPE_SIZE on (K.NO_TYPE = E.NO_TYPE)'
      'where ((MST.NO_MOD = :NM) and (MST.IS_ENABLE = 1))'
      'order by 3  '
      '')
    Left = 168
    Top = 360
    ParamData = <
      item
        Name = 'NM'
        ParamType = ptInput
      end>
  end
end
