  object qAgent: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select DATA_OTP,'
      '       ST_NAME,'
      '       AG_NAME,'
      '       NO_AGN,'
      '       PRIM_ZAK,'
      '       IS_OK,'
      '       NO_SZ,'
      '       M_CNT_MOD'
      'from READ_SET_ZAKAZ_MAIN'
      'WHERE ((DATA_OTP = :ED))'
      '')
    Left = 64
    Top = 504
    ParamData = <
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qMod: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT MST.NO_MOD,'
      '       MT.NAZVAN,'
      '       SUM(SZD.CNT_MOD) SUM_OF_CNT_MOD,'
      '       SZD.IS_OK'
      'FROM SET_ZAKAZ_DETAIL SZD'
      'INNER JOIN MODEL_SIZE_TABLE MST ON (SZD.NO_MSIS = MST.NO_MST)'
      'INNER JOIN MODEL_TABLE MT ON (MST.NO_MOD = MT.NO_MOD)'
      'WHERE ((SZD.NO_SET_ZAK = :SZ))'
      'GROUP BY MST.NO_MOD, MT.NAZVAN, SZD.IS_OK'
      'ORDER BY MT.NAZVAN  '
      '')
    Left = 64
    Top = 560
    ParamData = <
      item
        Name = 'SZ'
        ParamType = ptInput
      end>
  end
  object qSize: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT SZD.NO_SZD,'
      '       MST.NO_MOD,'
      '       SZD.IS_OK,'
      '       SZD.CNT_MOD,'
      '       SM.NO_SIZE'
      'FROM SIZE_MOD_TABLE SM'
      'INNER JOIN MODEL_SIZE_TABLE MST ON (SM.NO_SMT = MST.NO_SIZE)'
      'INNER JOIN SET_ZAKAZ_DETAIL SZD ON (MST.NO_MST = SZD.NO_MSIS)'
      'WHERE ((SZD.NO_SET_ZAK = :SZ) AND'
      '      (MST.NO_MOD = :NM))'
      'ORDER BY SM.NO_SIZE  '
      '')
    Left = 64
    Top = 617
    ParamData = <
      item
        Name = 'SZ'
        ParamType = ptInput
      end
      item
        Name = 'NM'
        ParamType = ptInput
      end>
  end
end
