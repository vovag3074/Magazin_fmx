  object qStop: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'insert into LOG_START_STOP_SHOP (DATA_STOP)'
      'values (:DATA_STOP)'
      '')
    ParamData = <
      item
        Name = 'DATA_STOP'
        ParamType = ptInput
      end>
    Left = 72
    Top = 280
  end
  object qData: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select END_BAZAR, START_BAZAR'
      'from GET_DIAPAZON_BAZAR'
      '')
    Left = 240
    Top = 51
  end
  object qMove: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select MS.UN_CODE, count(LM.NO_SIZE_MOD) COUNT_OF_NO_SIZE_MOD'
      'from LOG_MOVE_TABLE_2 LM'
      'inner join MODEL_SIZE_TABLE MS on (LM.NO_SIZE_MOD = MS.NO_MST)'
      'where ((LM.IS_RET = 0) and'
      '      (LM.DATA_TIME_MOVE between :SD and :ED))'
      'group by MS.UN_CODE  '
      '')
    Left = 288
    Top = 51
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qSity: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select DISTINCT '
      '       S.BAR_CODE ST_BAR_CODE,'
      '       S.ST_NAME,'
      '       S.IS_DEL,'
      '       S.IS_STAR'
      'from SITY_TABLE S'
      'inner join AGENTS AG on (S.NO_ST = AG.NO_SITY)'
      'inner join LOG_PROD_TABLE LP on (AG.NO_AGN = LP.NO_AGN)'
      'where ((LP.DATA_PROD between :SD and :ED))'
      'order by S.ST_NAME  '
      '')
    Left = 240
    Top = 107
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qAgn: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT DISTINCT '
      '    V.NAZVAN V_NAZVAN,'
      '    AG.AG_NAME,'
      '    AG.BAR_CODE AG_BAR_CODE,'
      '    AG.AG_DOLG,'
      '    AG.IS_DEF_PROD,'
      '    AG.IS_SKIDKA,'
      '    AG.IS_DEL,'
      '    AG.AG_DOP,'
      '    S.BAR_CODE ST_BAR_CODE'
      'FROM SITY_TABLE S'
      '   INNER JOIN AGENTS AG ON (S.NO_ST = AG.NO_SITY)'
      '   INNER JOIN LOG_PROD_TABLE LP ON (AG.NO_AGN = LP.NO_AGN)'
      '   INNER JOIN VALUT_TABLE V ON (AG.PRED_VAL = V.NO_VAL)'
      'WHERE '
      '   ('
      '      (LP.DATA_PROD BETWEEN :SD AND :ED)'
      '   )'
      '')
    Left = 296
    Top = 107
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qProd: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT AG.BAR_CODE,'
      '       V.NAZVAN,'
      '       MST.UN_CODE,'
      '       LP.CENA_PROD,'
      '       LP.OPLATA,'
      '       LP.DATA_PROD'
      'FROM LOG_PROD_TABLE LP'
      'INNER JOIN AGENTS AG ON (LP.NO_AGN = AG.NO_AGN)'
      'INNER JOIN VALUT_TABLE V ON (LP.NO_VAL = V.NO_VAL)'
      'INNER JOIN MODEL_SIZE_TABLE MST ON (LP.NO_MOD_SIZE = MST.NO_MST)'
      'WHERE ((LP.DATA_PROD BETWEEN :SD AND :ED)) '
      '')
    Left = 344
    Top = 51
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qOpl: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT AG.BAR_CODE,'
      '       SUM(LP.SUM_OP) SUM_OF_SUM_OP,'
      '       MST.UN_CODE,'
      '       LP.DATA_OP,'
      '       LP.IS_VIRT,'
      '       LP.IS_PRED'
      'FROM MODEL_SIZE_TABLE MST'
      'INNER JOIN LOG_OPLATA LP ON (MST.NO_MST = LP.NO_MSIS)'
      'INNER JOIN AGENTS AG ON (LP.NO_AGN = AG.NO_AGN)'
      'WHERE ((LP.DATA_OP BETWEEN :SD AND :ED))'
      
        'GROUP BY AG.BAR_CODE, MST.UN_CODE, LP.DATA_OP, LP.IS_VIRT, LP.IS' +
        '_PRED  '
      '')
    Left = 344
    Top = 115
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
  object qRet: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select MS.UN_CODE, count(LM.NO_SIZE_MOD) COUNT_OF_NO_SIZE_MOD'
      'from LOG_MOVE_TABLE_2 LM'
      'inner join MODEL_SIZE_TABLE MS on (LM.NO_SIZE_MOD = MS.NO_MST)'
      'where ((LM.IS_RET = 1) and'
      '      (LM.DATA_TIME_MOVE between :SD and :ED))'
      'group by MS.UN_CODE  '
      '')
    Left = 240
    Top = 171
    ParamData = <
      item
        Name = 'SD'
        ParamType = ptInput
      end
      item
        Name = 'ED'
        ParamType = ptInput
      end>
  end
end
