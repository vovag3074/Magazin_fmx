  object qMod: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select SUM_OF_CNT_MOD,'
      '       M_CENA,'
      '       M_NAZVAN,'
      '       K_NAZVAN,'
      '       NO_MOD,'
      '       CODE_MOD'
      'from RET_ZAK_DETAIL(:NZ)'
      'order by K_NAZVAN, M_NAZVAN'
      '')
    Left = 40
    Top = 312
    ParamData = <
      item
        Name = 'NZ'
        ParamType = ptInput
      end>
  end
  object qRead: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select SZ.DATA_OTP,'
      '       SZ.NO_AGN,'
      '       SZ.PRIM_ZAK,'
      '       (AG.AG_NAME||'#39' '#39'||ST.ST_NAME)Full_AG_Name'
      'from SET_ZAKAZ SZ'
      'inner join AGENTS AG on (SZ.NO_AGN = AG.NO_AGN)'
      'inner join SITY_TABLE ST on (AG.NO_SITY = ST.NO_ST)'
      'where ((SZ.NO_SZ = :SZ))   '
      '')
    Left = 104
    Top = 312
    ParamData = <
      item
        Name = 'SZ'
        ParamType = ptInput
      end>
  end
  object qSize: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT SZD.NO_SZD,'
      '       MST.NO_MOD,'
      '       SZD.IS_OK,'
      '       SZD.CNT_MOD,'
      '       SM.NO_SIZE,'
      '       MST.UN_CODE'
      'FROM SIZE_MOD_TABLE SM'
      'INNER JOIN MODEL_SIZE_TABLE MST ON (SM.NO_SMT = MST.NO_SIZE)'
      'INNER JOIN SET_ZAKAZ_DETAIL SZD ON (MST.NO_MST = SZD.NO_MSIS)'
      'WHERE ((SZD.NO_SET_ZAK = :SZ) AND'
      '      (MST.NO_MOD = :NM))'
      'ORDER BY SM.NO_SIZE  '
      '')
    Left = 160
    Top = 312
    ParamData = <
      item
        Name = 'SZ'
        ParamType = ptInput
      end
      item
        Name = 'NM'
        ParamType = ptInput
      end>
  end
  object qIns: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    UpdateOptions.AssignedValues = [uvFetchGeneratorsPoint, uvGeneratorName]
    CommandText.Strings = (
      
        'INSERT INTO SET_ZAKAZ (NO_AGN, DATA_PRIN, DATA_OTP, PRIM_ZAK, IS' +
        '_OK)'
      'VALUES (:NO_AGN, '#39'now'#39', :DATA_OTP, :PRIM_ZAK, 0)'
      'returning NO_SZ {into :NO_SZ} '
      ''
      '')
    ParamData = <
      item
        Name = 'NO_AGN'
        DataType = ftInteger
        ParamType = ptInput
        Value = Null
      end
      item
        Name = 'DATA_OTP'
        DataType = ftDate
        ParamType = ptInput
        Value = Null
      end
      item
        Name = 'PRIM_ZAK'
        DataType = ftDate
        ParamType = ptInput
        Value = Null
      end
      item
        Name = 'NO_SZ'
        DataType = ftInteger
        ParamType = ptInputOutput
        Value = Null
      end>
    Left = 32
    Top = 376
  end
  object qUpd: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update SET_ZAKAZ'
      'set NO_AGN = :NO_AGN,'
      '    DATA_OTP = :DATA_OTP,'
      '    PRIM_ZAK = :PRIM_ZAK'
      'where (NO_SZ = :SZ)'
      '')
    ParamData = <
      item
        Name = 'NO_AGN'
        ParamType = ptInput
      end
      item
        Name = 'DATA_OTP'
        ParamType = ptInput
      end
      item
        Name = 'PRIM_ZAK'
        ParamType = ptInput
      end
      item
        Name = 'SZ'
        ParamType = ptInput
      end>
    Left = 88
    Top = 376
  end
  object qDel: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'EXECUTE PROCEDURE DEL_MOD_FROM_SET_ZAKAZ(:UN_CODE, :NO_ZAK)'
      '')
