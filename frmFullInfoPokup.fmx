  object qLogAg: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select first(20) DATA_PROD,'
      '       COUNT_OF_NO_MOD_SIZE,'
      '       SUM_OF_CENA_PROD,'
      '       OPERATION, '
      '       LOG_DOP,'
      '       TYPE_OP'
      'from LOG_IN_OUT_AGENT(:NG)'
      'order by DATA_PROD desc'
      '')
    Left = 148
    Top = 201
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
  end
  object qLOpl: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT NAZVAN,'
      '        CENA_PROD,'
      '        OPLATA,'
      '        DATA_PROD,'
      '        NO_LPT,'
      '        DATA_OPL,'
      '        IS_PRED,'
      '        IS_VIRT'
      ' FROM GET_HISTORY_PROD_BY_OPLATA(:NG)'
      '')
    Left = 222
    Top = 209
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
  end
