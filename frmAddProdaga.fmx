  object qZak: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'SELECT AGN.AG_NAME,'
      '       ST.ST_NAME,'
      '       ZL.CODE_ZAK,'
      '       ZL.CNT_MOD,'
      '       ZL.NO_ZAK,'
      '       AGN.NO_AGN'
      'FROM ZAKAZ_LIST ZL'
      'INNER JOIN AGENTS AGN ON (ZL.NO_AGN = AGN.NO_AGN)'
      'INNER JOIN SITY_TABLE ST ON (AGN.NO_SITY = ST.NO_ST)'
      'WHERE ((ZL.IS_PROD = 0) AND'
      '      (ZL.DATA_END >= '#39'now'#39'))'
      'ORDER BY AGN.AG_NAME, ST.ST_NAME  ')
    Left = 760
    Top = 384
  end
  object qGetAgn: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      
        'select AGN.IS_SKIDKA, AGN.SUM_SKIDKA, AGN.FULL_NAME_STD, AGN.IS_' +
        'DEL'
      'from AGENTS AGN'
      'where AGN.NO_AGN = :NG     ')
    Left = 760
    Top = 440
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
  end
  object qMod: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select M.NAZVAN M_NAZVAN,'
      '       sum(LP.CENA_PROD) SUM_PROD,'
      '       sum(LP.OPLATA) OPLATA,'
      '       LP.CENA_PROD,'
      '       K.NAZVAN K_NAZVAN,'
      '       count(LP.NO_LPT) COUNT_OF_NO_LPT,'
      '       MS.NO_MOD'
      'from MODEL_SIZE_TABLE MS'
      'inner join LOG_PROD_TABLE LP on (MS.NO_MST = LP.NO_MOD_SIZE)'
      'inner join MODEL_TABLE M on (MS.NO_MOD = M.NO_MOD)'
      'inner join KATEGORY_TABLE K on (M.NO_KAT = K.NO_KAT)'
      'where ((LP.NO_AGN = :NG) and'
      '      (LP.DATA_PROD = :SD) and'
      '      (LP.IS_TEMP = 1))'
      'group by M.NAZVAN, LP.CENA_PROD, K.NAZVAN, MS.NO_MOD'
      'order by K.NAZVAN, M.NAZVAN  '
      '')
    Left = 96
    Top = 359
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end
      item
        Name = 'SD'
        ParamType = ptInput
      end>
  end
