  object qRead: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select ST.NO_ST, ST.ST_NAME, ST.IS_STAR'
      'from SITY_TABLE ST'
      'where ((ST.IS_DEL = 0))'
      'order by ST.IS_STAR desc, ST.ST_NAME  '
      '')
    Left = 32
    Top = 592
  end
  object qUsr: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select NO_AGN,'
      '       FULL_NAME,'
      '       UPPER_FULL_NAME,'
      '       AG_NAME,'
      '       ST_NAME,'
      '       IS_SKIDKA,'
      '       AG_DOLG,'
      '       NO_ST,'
      '       AG_PRED,'
      '       STATUS'
      'from GET_FULL_ACT_AGENT(:SORT_ID,:PG, :AGN, :NO_SITY)'
      '')
    Left = 80
    Top = 592
    ParamData = <
      item
        Name = 'SORT_ID'
        ParamType = ptInput
      end
      item
        Name = 'PG'
        ParamType = ptInput
      end
      item
        Name = 'AGN'
        ParamType = ptInput
      end
      item
        Name = 'NO_SITY'
        ParamType = ptInput
      end>
  end
  object qAddSity: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'insert into SITY_TABLE (ST_NAME, IS_DEL, IS_STAR)'
      'values (:ST_NAME, 0, :IS_STAR)'
      '')
    ParamData = <
      item
        Name = 'ST_NAME'
        ParamType = ptInput
      end
      item
        Name = 'IS_STAR'
        ParamType = ptInput
      end>
    Left = 40
    Top = 392
  end
  object qReadSity: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select ST.ST_NAME, ST.IS_STAR'
      'from SITY_TABLE ST'
      'where ST.NO_ST = :STN '
      '')
    Left = 96
    Top = 392
    ParamData = <
      item
        Name = 'STN'
        ParamType = ptInput
      end>
  end
  object qUpdSity: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update SITY_TABLE'
      'set ST_NAME = :ST_NAME,'
      '    IS_STAR = :IS_STAR'
      'where (NO_ST = :STN)'
      '')
    ParamData = <
      item
        Name = 'ST_NAME'
        ParamType = ptInput
      end
      item
        Name = 'IS_STAR'
        ParamType = ptInput
      end
      item
        Name = 'STN'
        ParamType = ptInput
      end>
    Left = 160
    Top = 400
  end
  object qDelSity: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update SITY_TABLE'
      'set IS_DEL = 1'
      'where (NO_ST = :STN)'
      '')
    ParamData = <
      item
        Name = 'STN'
        ParamType = ptInput
      end>
    Left = 216
    Top = 392
  end
  object qRefAgent: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    FetchOptions.AssignedValues = [evItems]
    FetchOptions.Items = []
    SQL.Strings = (
      'SELECT AG.AG_DOLG,'
      '       (AG.AG_PRED + AG.AG_BANK_PRED) AS AG_PRED,'
      '       AG.AG_NAME,'
      '       ST.ST_NAME,'
      '       AG.STATUS,'
      '       AG.FULL_NAME_STD AS FULL_NAME'
      'FROM SITY_TABLE ST'
      'INNER JOIN AGENTS AG ON (ST.NO_ST = AG.NO_SITY)'
      'WHERE ((AG.NO_AGN = :NG))   '
      '')
    Left = 369
    Top = 536
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
  end
  object qDolg: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select sum(AG.AG_DOLG) SUM_OF_AG_DOLG,'
      '       VL.NAZVAN'
      'from VALUT_TABLE VL'
      'inner join AGENTS AG on (VL.NO_VAL = AG.PRED_VAL)'
      'where AG.IS_DEL = 0'
      'group by VL.NAZVAN'
      'order by VL.NAZVAN  '
      '')
    Left = 561
    Top = 544
  end
  object qDelAgn: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update AGENTS'
      'set IS_DEL = 1'
      'where (NO_AGN = :NG)')
    ParamData = <
      item
        Name = 'NG'
        ParamType = ptInput
      end>
    Left = 313
    Top = 392
  end
  object qUpdUsrSity: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update AGENTS AG'
      'set AG.NO_SITY = :NO_SITY'
      'where (AG.NO_AGN = :NO_AGN)'
      '')
    ParamData = <
      item
        Name = 'NO_SITY'
        ParamType = ptInput
      end
      item
        Name = 'NO_AGN'
        ParamType = ptInput
      end>
    Left = 32
    Top = 464
  end
