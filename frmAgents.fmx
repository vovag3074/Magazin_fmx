  object qRead: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select ST.NO_ST, ST.ST_NAME, ST.IS_STAR'
      'from SITY_TABLE ST'
      'where ((ST.IS_DEL = 0))'
      'order by ST.IS_STAR desc, ST.ST_NAME  '
      '')
    Left = 32
    Top = 592
  end
  object qUsr: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select NO_AGN,'
      '       FULL_NAME,'
      '       UPPER_FULL_NAME,'
      '       AG_NAME,'
      '       ST_NAME,'
      '       IS_SKIDKA,'
      '       AG_DOLG,'
      '       NO_ST,'
      '       AG_PRED,'
      '       STATUS'
      'from GET_FULL_ACT_AGENT(:SORT_ID,:PG, :AGN, :NO_SITY)'
      '')
    Left = 80
    Top = 592
    ParamData = <
      item
        Name = 'SORT_ID'
        ParamType = ptInput
      end
      item
        Name = 'PG'
        ParamType = ptInput
      end
      item
        Name = 'AGN'
        ParamType = ptInput
      end
      item
        Name = 'NO_SITY'
        ParamType = ptInput
      end>
  end
  object qAddSity: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'insert into SITY_TABLE (ST_NAME, IS_DEL, IS_STAR)'
      'values (:ST_NAME, 0, :IS_STAR)'
      '')
    ParamData = <
      item
        Name = 'ST_NAME'
        ParamType = ptInput
      end
      item
        Name = 'IS_STAR'
        ParamType = ptInput
      end>
    Left = 40
    Top = 392
  end
