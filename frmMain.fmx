  object qTestZal: TFDQuery
    Connection = IBC
    Transaction = IBT_Read
    SQL.Strings = (
      'select ZL.IS_MOVE,'
      '       ZL.IS_PROD,'
      '       AG.AG_NAME,'
      '       ZL.NO_AGN,'
      '       ST.ST_NAME'
      'from SITY_TABLE ST'
      'inner join AGENTS AG on (ST.NO_ST = AG.NO_SITY)'
      'inner join ZAKAZ_LIST ZL on (AG.NO_AGN = ZL.NO_AGN)'
      'where ((ZL.CODE_ZAK = :CZ))   '
      '')
    Left = 168
    Top = 384
    ParamData = <
      item
        Name = 'CZ'
        ParamType = ptInput
      end>
  end
