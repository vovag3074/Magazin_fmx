  object qExpAgn: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct AG.AG_NAME,'
      '                AG.BAR_CODE AG_CODE,'
      '                AG.AG_DOP,'
      '                AG.IS_SKIDKA,'
      '                AG.AG_DOLG,'
      '                AG.AG_PRED,'
      '                ST.ST_NAME,'
      '                ST.IS_DEL,'
      '                ST.IS_STAR,'
      '                ST.BAR_CODE ST_CODE,'
      '                V.NAZVAN V_NAZVAN'
      'from VALUT_TABLE V'
      'inner join AGENTS AG on (V.NO_VAL = AG.PRED_VAL)'
      'inner join SET_ZAKAZ SZ on (AG.NO_AGN = SZ.NO_AGN)'
      'inner join SITY_TABLE ST on (AG.NO_SITY = ST.NO_ST)'
      'where ((SZ.DATA_OTP = :DE))'
      'order by AG.AG_NAME, ST.ST_NAME'
      '')
    Left = 232
    Top = 16
    ParamData = <
      item
        Name = 'DE'
        ParamType = ptInput
      end>
  end
  object qExp: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct MST.UN_CODE,'
      '                SZD.CNT_MOD,'
      '                SZD.DOG_SUM, '
      '                SZD.IS_DOG, '
      '                SZ.CODE_ZAKAZA,'
      '                SZ.DATA_PRIN,'
      '                SZ.PRIM_ZAK,'
      '                SZ.IS_OK,'
      '                AG.BAR_CODE'
      'from AGENTS AG'
      'inner join SET_ZAKAZ SZ on (AG.NO_AGN = SZ.NO_AGN)'
      'inner join SET_ZAKAZ_DETAIL SZD on (SZ.NO_SZ = SZD.NO_SET_ZAK)'
      'inner join MODEL_SIZE_TABLE MST on (SZD.NO_MSIS = MST.NO_MST)'
      'where ((SZ.DATA_OTP = :DE))'
      'order by SZ.CODE_ZAKAZA, MST.UN_CODE  '
      '')
    Left = 296
    Top = 16
    ParamData = <
      item
        Name = 'DE'
        ParamType = ptInput
      end>
  end
  object qExpMod: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct MT.NAZVAN M_NAZVAN,'
      '                MT.BARCODE,'
      '                KT.NAZVAN K_NAZVAN,'
      '                MT.M_CENA,'
      '                KT.SUM_SKID'
      'from KATEGORY_TABLE KT'
      'inner join MODEL_TABLE MT on (KT.NO_KAT = MT.NO_KAT)'
      'inner join MODEL_SIZE_TABLE MST on (MT.NO_MOD = MST.NO_MOD)'
      'inner join SET_ZAKAZ_DETAIL SZD on (MST.NO_MST = SZD.NO_MSIS)'
      'inner join SET_ZAKAZ SZ on (SZD.NO_SET_ZAK = SZ.NO_SZ)'
      'where ((SZ.DATA_OTP = :DE))'
      'order by KT.NAZVAN, MT.NAZVAN  '
      '')
    Left = 352
    Top = 24
    ParamData = <
      item
        Name = 'DE'
        ParamType = ptInput
      end>
  end
  object qSize: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct MST.UN_CODE,'
      '                MT.BARCODE,'
      '                SMT.NO_SIZE'
      'from SIZE_MOD_TABLE SMT'
      'inner join MODEL_SIZE_TABLE MST on (SMT.NO_SMT = MST.NO_SIZE)'
      'inner join SET_ZAKAZ_DETAIL SZD on (MST.NO_MST = SZD.NO_MSIS)'
      'inner join SET_ZAKAZ SZ on (SZD.NO_SET_ZAK = SZ.NO_SZ)'
      'inner join MODEL_TABLE MT on (MST.NO_MOD = MT.NO_MOD)'
      'where ((SZ.DATA_OTP = :DE))'
      'order by MST.UN_CODE, SMT.NO_SIZE, MT.BARCODE '
      '')
    Left = 408
    Top = 16
    ParamData = <
      item
        Name = 'DE'
        ParamType = ptInput
      end>
  end
  object qZak: TFDQuery
    Connection = fmMain.IBC
    Transaction = fmMain.IBT_Read
    SQL.Strings = (
      'select distinct MST.UN_CODE,'
      '                SZD.CNT_MOD,'
      '                SZD.DOG_SUM, '
      '                SZD.IS_DOG, '
      '                SZ.CODE_ZAKAZA,'
      '                SZ.DATA_PRIN,'
      '                SZ.PRIM_ZAK,'
      '                SZ.IS_OK,'
      '                AG.BAR_CODE'
      'from AGENTS AG'
      'inner join SET_ZAKAZ SZ on (AG.NO_AGN = SZ.NO_AGN)'
      'inner join SET_ZAKAZ_DETAIL SZD on (SZ.NO_SZ = SZD.NO_SET_ZAK)'
      'inner join MODEL_SIZE_TABLE MST on (SZD.NO_MSIS = MST.NO_MST)'
      'where ((SZ.DATA_OTP = :DE))'
      'order by SZ.CODE_ZAKAZA, MST.UN_CODE  '
      '')
    Left = 456
    Top = 24
    ParamData = <
      item
        Name = 'DE'
        ParamType = ptInput
      end>
  end
  object qComt: TFDCommand
    Connection = fmMain.IBC
    Transaction = fmMain.IBT
    CommandText.Strings = (
      'update SET_ZAKAZ'
      'set IS_EXP = 1'
      'where IS_EXP = 0   '
      '')
    Left = 504
    Top = 32
  end
